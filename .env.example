# Exemplo de configuração do Habblaud (.env.example)
# Copie para .env e ajuste conforme desejado:

# Terminal interativo (abrir terminais xterm.js, assumir sessões, contratar novos agentes, arquiteto)
HABBLAUD_PTY=1

# Envio de mensagens e comandos ao vivo aos agentes
HABBLAUD_MENSAGENS=1

# Provedores suportados (1 = ligado, 0 = desligado)
HABBLAUD_ANTIGRAVITY=1
HABBLAUD_CODEX=1
HABBLAUD_OPENCODE=1

# Linha do tempo (gravação do timelapse para reprodução rápida do dia)
HABBLAUD_TIMELINE=1

# Porta do servidor (padrão: 4747)
HABBLAUD_PORT=4747

# Executáveis customizados (opcional se já estiverem no PATH):
# HABBLAUD_AGY_BIN=C:\Users\...\agy.exe
# HABBLAUD_CLAUDE_BIN=claude
# HABBLAUD_CODEX_BIN=codex
